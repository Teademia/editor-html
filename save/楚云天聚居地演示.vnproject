{
  "__version": 1,
  "project": {
    "title": "楚云天聚居地演示",
    "story_bible": {
      "opening": "末世第十九个月，楚云天在前任首领死亡后接管北山聚居地。玩家开局分配经济、科技、文化、政治共20点，随后通过治理选择、低属性危机和兽潮QTE走向不同基地结局。经济过低会触发饥荒，政治过低会触发起义，经济与科技不足且QTE失败会导致兽潮毁灭。",
      "target_words": 8000,
      "world": {
        "setting": "近未来末世废土。红雾感染和资源断供摧毁旧城市，幸存者以小型聚居地形式生存。北山聚居地位于一所废弃山地学校改造的基地中，有围墙、粮仓、净水井、温室和旧广播塔。",
        "rules": "1. 四属性代表基地发展路线：经济代表贸易与资源，科技代表工程与净水种植，文化代表凝聚力与公共信任，政治代表秩序与组织能力。2. 每次选择会改变属性。3. 终局根据最高属性展示不同基地方向。4. 剧情以毕业设计演示为目标，流程短、分支清晰、便于展示。",
        "tone": "克制、现实、带有末世治理感。重点不是打怪，而是资源分配、秩序重建与公共选择。"
      },
      "protagonist": {
        "name": "楚云天",
        "personality": [
          "理性",
          "克制",
          "责任感强",
          "擅长工程判断"
        ],
        "motivation": "让北山聚居地从临时避难所变成真正可以延续的基地。",
        "flaw": "习惯把社会问题当成工程问题，容易低估人的恐惧、怨恨和希望。"
      },
      "variables": [
